# Ignore everything by default
*

# Allow .gitignore
!.gitignore

# Allow only root-level .ts, .md, .js and config files
!/*.ts
!/*.md
!/*.js
!/package.json
!/package-lock.json
!/pnpm-lock.yaml
!/yarn.lock

# Ignore test files in root
/*.test.ts
/*.spec.ts

# Ignore all subdirectories and their contents
*/
